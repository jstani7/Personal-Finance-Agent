# Orq.ai configuration (default)
ORQ_API_KEY=your-orq-api-key-here
# ORQ_BASE_URL=https://api.orq.ai/v3/router
# ORQ_MODEL=deepseek-v4-flash

# Alternatively, direct OpenAI or compatible endpoint (e.g. Ollama, Groq, OpenRouter):
